# FastAPI manual local development environment
# Use this when running: cd apps/api; uvicorn app.main:app --reload
# The hostname is localhost because the backend is outside Docker.

SCAMSHIELD_APP_NAME=ScamShieldAI API
SCAMSHIELD_APP_VERSION=0.1.0
SCAMSHIELD_ENVIRONMENT=local
SCAMSHIELD_API_PREFIX=/api/v1
SCAMSHIELD_LOG_LEVEL=INFO
SCAMSHIELD_RATE_LIMIT_REQUESTS_PER_MINUTE=240
SCAMSHIELD_CORS_ORIGINS=http://localhost:3000
SCAMSHIELD_DATABASE_URL=postgresql+psycopg://scamshield:change_me_dev_password@localhost:5432/scamshieldai
SCAMSHIELD_JWT_SECRET_KEY=change-this-local-development-secret-at-least-32-chars
SCAMSHIELD_JWT_ALGORITHM=HS256
SCAMSHIELD_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
SCAMSHIELD_AUTH_COOKIE_NAME=scamshield_access_token
SCAMSHIELD_SCAM_CLASSIFIER_MODEL_PATH=ml/models/classical/best_model.joblib
SCAMSHIELD_SCAM_CLASSIFIER_MODEL_CARD_PATH=ml/models/classical/model_card.json
SCAMSHIELD_PERSUASION_CLASSIFIER_MODEL_PATH=ml/models/transformers/persuasion
SCAMSHIELD_ASSISTANT_PROVIDER=local
SCAMSHIELD_ASSISTANT_MODEL=gpt-4.1-mini
SCAMSHIELD_OPENAI_API_KEY=
SCAMSHIELD_GEMINI_API_KEY=
SCAMSHIELD_LLAMA_BASE_URL=
SCAMSHIELD_LLAMA_API_KEY=
SCAMSHIELD_ASSISTANT_KNOWLEDGE_DIR=knowledge
SCAMSHIELD_ASSISTANT_VECTOR_DIR=ml/vectorstores/scamshield
SCAMSHIELD_ASSISTANT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SCAMSHIELD_NOTIFICATION_HIGH_RISK_THRESHOLD=71
SCAMSHIELD_NOTIFICATION_CRITICAL_THRESHOLD=90
SCAMSHIELD_EMAIL_NOTIFICATIONS_ENABLED=false
SCAMSHIELD_NOTIFICATION_FROM_EMAIL=alerts@scamshieldai.example
SCAMSHIELD_SMTP_HOST=
SCAMSHIELD_SMTP_PORT=587
SCAMSHIELD_SMTP_USERNAME=
SCAMSHIELD_SMTP_PASSWORD=
SCAMSHIELD_SMTP_USE_TLS=true
SCAMSHIELD_ENTERPRISE_API_KEYS=dev-enterprise-key
SCAMSHIELD_ENTERPRISE_MAX_BATCH_SIZE=100
SCAMSHIELD_SPEECH_RECOGNITION_PROVIDER=external
SCAMSHIELD_SPEECH_RECOGNITION_MODEL=whisper-large-v3