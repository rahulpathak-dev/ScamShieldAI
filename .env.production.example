POSTGRES_DB=scamshieldai
POSTGRES_USER=scamshield
POSTGRES_PASSWORD=change_me_strong_database_password
REDIS_PASSWORD=change_me_strong_redis_password
BACKUP_RETENTION_DAYS=14

SCAMSHIELD_API_IMAGE=ghcr.io/your-org/scamshieldai-api:latest
SCAMSHIELD_WEB_IMAGE=ghcr.io/your-org/scamshieldai-web:latest
SCAMSHIELD_ENVIRONMENT=production
SCAMSHIELD_LOG_LEVEL=INFO
SCAMSHIELD_CORS_ORIGINS=https://app.scamshieldai.example
SCAMSHIELD_JWT_SECRET_KEY=change_me_minimum_32_character_jwt_secret
SCAMSHIELD_AUTH_COOKIE_NAME=scamshield_access_token

NEXT_PUBLIC_API_BASE_URL=https://api.scamshieldai.example

SCAMSHIELD_OPENAI_API_KEY=
SCAMSHIELD_GEMINI_API_KEY=
SCAMSHIELD_LLAMA_BASE_URL=
SCAMSHIELD_LLAMA_API_KEY=

SCAMSHIELD_ENTERPRISE_API_KEYS=replace-with-enterprise-key-1,replace-with-enterprise-key-2
SCAMSHIELD_ENTERPRISE_MAX_BATCH_SIZE=100

SCAMSHIELD_EMAIL_NOTIFICATIONS_ENABLED=false
SCAMSHIELD_NOTIFICATION_FROM_EMAIL=alerts@scamshieldai.example
SCAMSHIELD_SMTP_HOST=
SCAMSHIELD_SMTP_PORT=587
SCAMSHIELD_SMTP_USERNAME=
SCAMSHIELD_SMTP_PASSWORD=
SCAMSHIELD_SMTP_USE_TLS=true